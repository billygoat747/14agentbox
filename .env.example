# 14agentbox Host Secrets
# These secrets are read EXCLUSIVELY on your host machine by proxy.py.
# They are NEVER passed into Docker or readable by tools inside the container.

# LLM Providers
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GOOGLEAI_API_KEY=
GEMINI_API_KEY=
LITELLM_API_KEY=
# Root URL of your LiteLLM instance, without /v1 (e.g. https://litellm.example.com).
# LiteLLM is only enabled when both LITELLM_API_KEY and LITELLM_BASE_URL are set.
LITELLM_BASE_URL=

# Search / MCP Tools
EXA_API_KEY=

# Optional local overrides
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
