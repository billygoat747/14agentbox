{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/openai/gpt-5.6-luna",
  "permission": "allow",
  "snapshot": false,
  "provider": {
    "openrouter": {
      "options": {
        "baseURL": "http://host.docker.internal:8040/openrouter/api/v1",
        "apiKey": "14agentbox-sandbox-token"
      },
      "models": {
        "openai/gpt-6-luna": {
          "name": "OpenAI: GPT-6 Luna",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "openai/gpt-5.6-luna": {},
        "xiaomi/mimo-v2.6-pro": {
          "name": "Xiaomi: MiMo-V2.6-Pro",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://host.docker.internal:8040/litellm/v1",
        "apiKey": "14agentbox-sandbox-token"
      }
    },
    "openai": {
      "options": {
        "baseURL": "http://host.docker.internal:8040/openai/v1",
        "apiKey": "14agentbox-sandbox-token"
      },
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "google": {
      "options": {
        "baseURL": "http://host.docker.internal:8040/google",
        "apiKey": "14agentbox-sandbox-token"
      }
    }
  },
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "http://host.docker.internal:8040/mcp/exa",
      "enabled": true
    }
  }
}
